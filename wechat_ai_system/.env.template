# 微信朋友圈AI画像系统环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 数据库配置
USE_SQLITE=true
DATABASE_URL=sqlite:///wechat_system.db

# AI服务配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# HMAC认证配置 (用于测试)
TEST_APP_ID=wechat_exe_client
TEST_APP_SECRET=your_hmac_secret_here

# Flask配置
FLASK_ENV=development
SECRET_KEY=your_flask_secret_key_here

# 日志配置
LOG_LEVEL=INFO
